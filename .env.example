# ---------------------------------------------------------------
# Gexi settings. Copy this file to ".env" and fill in the values.
# Never commit the real .env file: it holds secrets.
# ---------------------------------------------------------------

# Address of the PostgreSQL database
DATABASE_URL=postgres://gexi:gexi@localhost:5432/gexi
# Separate database used only by the automated tests (it gets wiped)
DATABASE_URL_TEST=postgres://gexi:gexi@localhost:5432/gexi_test

# Port the API server listens on
PORT=4000
# Public address of the website (used for payment return links)
APP_URL=http://localhost:5173

# Long random text used to sign login sessions. Change it in production!
JWT_SECRET=change-me-to-a-long-random-string

# --- Payments ---
# "mock"  = fake payment page, no Chapa account needed (good for clicking around)
# "chapa" = real Chapa (use your TEST secret key during development)
PAYMENT_PROVIDER=mock
CHAPA_SECRET_KEY=
# Secret you set in the Chapa dashboard for webhooks (optional but recommended)
CHAPA_WEBHOOK_SECRET=
# Public address Chapa can reach for webhooks (e.g. an ngrok URL). Leave empty locally.
API_PUBLIC_URL=

# --- SMS ---
# "console" = print messages in the terminal and save them in the SMS log
SMS_PROVIDER=console

# Turns on developer tools such as "fast-forward time". Never enable in production.
ENABLE_DEV_TOOLS=true
