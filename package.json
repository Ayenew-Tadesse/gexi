{
  "name": "gexi",
  "private": true,
  "version": "0.1.0",
  "description": "Pickup-only marketplace for Addis Ababa",
  "workspaces": ["server", "client"],
  "scripts": {
    "setup": "npm run db:migrate -w server && npm run db:seed -w server",
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm run test -w server",
    "i18n:check": "node client/scripts/i18n-check.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
